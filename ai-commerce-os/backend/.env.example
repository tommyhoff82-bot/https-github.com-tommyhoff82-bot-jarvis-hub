DATABASE_URL="paste_your_supabase_url"
REDIS_URL="paste_your_upstash_url"
OPENAI_API_KEY="paste_your_openai_key"
PINECONE_API_KEY="paste_your_pinecone_key"
PINECONE_ENVIRONMENT="paste_your_pinecone_env"
PINECONE_INDEX="commerce-learnings"
# Not currently used by any code path — the app has each workspace paste
# its own Shopify custom-app access token in /settings/integrations
# instead of a Partners OAuth install flow. Kept here because Phase 1 of
# the guide has you create these; wire them up if you build that flow.
SHOPIFY_API_KEY="paste_here"
SHOPIFY_API_SECRET="paste_here"
# One secret for every store's order webhooks on this deployment (Shopify
# gives you this per custom app, not per store) — see the routing note in
# api/webhooks/shopify.py if you need genuinely per-store secrets.
SHOPIFY_WEBHOOK_SECRET="paste_here"
# Fallback only, for calling backend/integrations/printify.py functions
# directly (a script, a shell). Real order fulfillment through the
# Shopify webhook always uses the fulfilling workspace's own connected
# Printify credentials from /settings/integrations, not this value.
PRINTIFY_API_KEY="paste_here"
STRIPE_SECRET_KEY="paste_here"
STRIPE_PUBLISHABLE_KEY="paste_here"
STRIPE_WEBHOOK_SECRET="paste_here"
# Price IDs from your own Stripe dashboard (Products -> pricing). Only
# needed once you're ready to sell subscriptions; GET /api/billing/plans
# will still respond without them, just without a working checkout link.
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ENTERPRISE=""

# Generate with: openssl rand -hex 32
JWT_SECRET="paste_a_random_secret_here"
JWT_EXPIRE_MINUTES=10080

# Your deployed frontend origin, for CORS. Keep localhost while developing.
FRONTEND_URL="http://localhost:3000"
