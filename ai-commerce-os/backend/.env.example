DATABASE_URL="paste_your_supabase_url"
REDIS_URL="paste_your_upstash_url"
OPENAI_API_KEY="paste_your_openai_key"
PINECONE_API_KEY="paste_your_pinecone_key"
PINECONE_ENVIRONMENT="paste_your_pinecone_env"
PINECONE_INDEX="commerce-learnings"
SHOPIFY_API_KEY="paste_here"
SHOPIFY_API_SECRET="paste_here"
SHOPIFY_WEBHOOK_SECRET="paste_here"
PRINTIFY_API_KEY="paste_here"
STRIPE_SECRET_KEY="paste_here"
STRIPE_PUBLISHABLE_KEY="paste_here"
STRIPE_WEBHOOK_SECRET="paste_here"
# Price IDs from your own Stripe dashboard (Products -> pricing). Only
# needed once you're ready to sell subscriptions; GET /api/billing/plans
# will still respond without them, just without a working checkout link.
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ENTERPRISE=""
PRINTIFY_SHOP_ID="paste_your_printify_shop_id"

# Generate with: openssl rand -hex 32
JWT_SECRET="paste_a_random_secret_here"
JWT_EXPIRE_MINUTES=10080

# Your deployed frontend origin, for CORS. Keep localhost while developing.
FRONTEND_URL="http://localhost:3000"
